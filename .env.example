# ASP-X environment variables
# Copy to .env and fill in your values

# Any OpenAI-compatible LLM endpoint
ASP_X_LLM_BASE_URL=https://api.openai.com/v1
ASP_X_LLM_API_KEY=sk-your-key-here

# Default model for evaluation (a cheap/fast one is fine for dev)
ASP_X_DEFAULT_MODEL=gpt-4o-mini

# Model used for LLM-based judging (cheap is fine)
ASP_X_JUDGE_MODEL=gpt-4o-mini

# Backend HTTP port (used by both `asp-x serve` and the frontend dev server proxy)
ASP_X_SERVER_PORT=4399
